# ──────────────────────────────────────────────────────
# Metapi 裸机部署环境变量配置
# 复制为 .env 后修改: cp .env.example .env
# ──────────────────────────────────────────────────────

# [必须] 管理后台登录令牌
AUTH_TOKEN=change-me-admin-token

# [必须] 下游客户端调用 /v1/* 的 Token
PROXY_TOKEN=change-me-proxy-sk-token

# 服务端口
PORT=4000

# 数据存储目录
DATA_DIR=/opt/metapi/data

# 自动签到 Cron（默认每日 8:00）
CHECKIN_CRON=0 8 * * *

# 余额刷新 Cron（默认每小时）
BALANCE_REFRESH_CRON=0 * * * *

# 时区
TZ=Asia/Shanghai

# ─── 低内存优化 ──────────────────────────────────────
# 限制 Node.js 堆内存上限（MB）
# 2核1G 服务器建议 192-256，2G 以上可设 384-512
NODE_OPTIONS=--max-old-space-size=256

# ─── 自动更新配置 ──────────────────────────────────────
# GitHub Release API 地址（检查新版本用）
# 如使用 Fork，替换为你的仓库地址
UPDATE_CHECK_URL=https://api.github.com/repos/zczy-k/metapi/releases/latest

# 更新通知 Webhook（可选，支持 Slack/Discord/企业微信/钉钉）
# WEBHOOK_URL=https://hooks.slack.com/services/xxx
